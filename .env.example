# Public application configuration
NEXT_PUBLIC_SITE_URL=https://laypipe.fun

# Audited Robinhood deployment manifest. The browser remains read-only until
# every field is set and its live RPC preflight matches exactly.
# Earliest receipt block across every watched deployment transaction.
NEXT_PUBLIC_LAYPIPE_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_LAYPIPE_FACTORY_ADDRESS=
NEXT_PUBLIC_LAYPIPE_FACTORY_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_FACTORY_IMPLEMENTATION_ADDRESS=
NEXT_PUBLIC_LAYPIPE_FACTORY_IMPLEMENTATION_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_TOKEN_IMPLEMENTATION_ADDRESS=
NEXT_PUBLIC_LAYPIPE_TOKEN_IMPLEMENTATION_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_HOOK_ADDRESS=
NEXT_PUBLIC_LAYPIPE_HOOK_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_SWAP_ROUTER_ADDRESS=
NEXT_PUBLIC_LAYPIPE_SWAP_ROUTER_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_SELF_BURNER_ADDRESS=
NEXT_PUBLIC_LAYPIPE_SELF_BURNER_RUNTIME_CODEHASH=
NEXT_PUBLIC_LAYPIPE_REVENUE_ROUTER_ADDRESS=
NEXT_PUBLIC_LAYPIPE_REVENUE_ROUTER_RUNTIME_CODEHASH=
NEXT_PUBLIC_UNISWAP_V4_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_LAYPIPE_FINAL_OWNER_ADDRESS=
NEXT_PUBLIC_LAYPIPE_TREASURY_ADDRESS=
NEXT_PUBLIC_LAYPIPE_OPERATIONS_ADDRESS=
NEXT_PUBLIC_LAYPIPE_CREATOR_CONFIG_ID=
NEXT_PUBLIC_LAYPIPE_SELF_BURN_CONFIG_ID=
NEXT_PUBLIC_LAYPIPE_LAUNCH_FEE_WEI=
NEXT_PUBLIC_LAYPIPE_LAUNCH_SUPPLY_WEI=
NEXT_PUBLIC_LAYPIPE_TICK_SPACING=
NEXT_PUBLIC_LAYPIPE_START_TICK=
NEXT_PUBLIC_LAYPIPE_SELF_BURN_MAX_PER_CALL_WEI=
NEXT_PUBLIC_LAYPIPE_SELF_BURN_BOUNTY_BPS=
NEXT_PUBLIC_LAYPIPE_REVENUE_MAX_SEQUESTER_PER_CALL_WEI=
NEXT_PUBLIC_LAYPIPE_REVENUE_MAX_TREASURY_ROUTE_PER_CALL_WEI=
NEXT_PUBLIC_LAYPIPE_REVENUE_BOUNTY_BPS=
NEXT_PUBLIC_LAYPIPE_SOURCE_COMMIT=
NEXT_PUBLIC_LAYPIPE_COMPILER_VERSION=
NEXT_PUBLIC_LAYPIPE_ABI_BUNDLE_SHA256=
NEXT_PUBLIC_LAYPIPE_ARTIFACT_BUNDLE_SHA256=

# Neon Postgres. Keep server-only; never prefix with NEXT_PUBLIC_. Both runtime
# URLs must target the same primary branch with separate least-privilege roles.
DATABASE_READ_URL=
DATABASE_WRITE_URL=
# Operator CLI only. Never add the schema-owner credential to Vercel.
DATABASE_MIGRATION_URL=
LAYPIPE_DB_READ_ROLE=laypipe_runtime_read
LAYPIPE_DB_WRITE_ROLE=laypipe_runtime_write
LAYPIPE_DB_SERVICE_ROLE=laypipe_runtime_service

# Board data is deliberately opt-in. `fixture` never falls through to the
# database; switch to `live` only after migration, backfill, and health checks.
LAYPIPE_MARKET_MODE=fixture

# Robinhood Chain indexing and transaction simulation
ROBINHOOD_RPC_HTTP_URL=
# Optional. HTTP backfill plus authenticated webhooks is the primary path.
ROBINHOOD_RPC_WS_URL=
# Explicit write-side kill switch. Keep false until the migration, complete
# audited manifest, production RPC, and isolated backfill rehearsal are green.
INDEXER_ENABLED=false
INDEXER_FINALITY_BLOCKS=
# Ten blocks works with Alchemy's Robinhood free-tier eth_getLogs limit.
INDEXER_BATCH_SIZE=10
INDEXER_MAX_BATCHES_PER_RUN=25
INDEXER_MAX_LOGS=5000
INDEXER_MAX_NEW_LAUNCHES=25
INDEXER_FILTER_CHUNK_SIZE=100
INDEXER_MAX_FILTER_CHUNKS=25
INDEXER_REORG_LOOKBACK=128
INDEXER_RUN_TIMEOUT_MS=45000
CRON_SECRET=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# IPFS pinning. The JWT must remain server-only.
IPFS_PINNING_ENABLED=false
PINATA_JWT=
IPFS_GATEWAY_BASE_URL=
WALLET_CHALLENGE_SECRET=

# Abuse protection for uploads and mutation endpoints. These first two names
# match the variables injected by Vercel's Upstash Marketplace integration.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Optional local/portable aliases accepted by the server implementation.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
