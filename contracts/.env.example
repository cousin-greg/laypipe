# Public chain endpoint and pinned release-evidence block.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FORK_BLOCK=22642189

# Keep the real key only in contracts/.env, which is ignored by git.
DEPLOYER_PRIVATE_KEY=

# Final two-step owner, ideally a Safe, plus policy destinations.
FINAL_OWNER=
TREASURY_WALLET=
OPERATIONS_WALLET=

# All economic values below are intentionally blank. They are PIPEDOG base
# units or explicit curve parameters and must be calibrated before deployment.
LAYPIPE_SUPPLY_WEI=
LAYPIPE_TICK_SPACING=
LAYPIPE_START_TICK=
LAYPIPE_LAUNCH_FEE_PIPEDOG_WEI=
MAX_SEQUESTER_PER_CALL_PIPEDOG_WEI=
MAX_TREASURY_ROUTE_PER_CALL_PIPEDOG_WEI=
MAX_SELF_BURN_PER_CALL_PIPEDOG_WEI=
ROUTER_BOUNTY_BPS=
SELF_BURN_BOUNTY_BPS=

# Isolated Base Sepolia rehearsal. This deploys a fixed-supply mock tPIPEDOG;
# none of these values or addresses are Robinhood production configuration.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Optional. Each defaults to the Base Sepolia deployer when omitted.
# BASE_SEPOLIA_FINAL_OWNER=
# BASE_SEPOLIA_TREASURY_WALLET=
# BASE_SEPOLIA_OPERATIONS_WALLET=

# Explicit throwaway test values. Do not copy production economics here or
# promote these values from a rehearsal into the Robinhood deployment.
BASE_SEPOLIA_MOCK_PIPEDOG_SUPPLY_WEI=
BASE_SEPOLIA_LAYPIPE_SUPPLY_WEI=
BASE_SEPOLIA_LAYPIPE_TICK_SPACING=
BASE_SEPOLIA_LAYPIPE_START_TICK=
BASE_SEPOLIA_LAUNCH_FEE_MOCK_PIPEDOG_WEI=
BASE_SEPOLIA_MAX_SEQUESTER_PER_CALL_WEI=
BASE_SEPOLIA_MAX_TREASURY_ROUTE_PER_CALL_WEI=
BASE_SEPOLIA_MAX_SELF_BURN_PER_CALL_WEI=
BASE_SEPOLIA_ROUTER_BOUNTY_BPS=
BASE_SEPOLIA_SELF_BURN_BOUNTY_BPS=
