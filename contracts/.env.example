# Public chain endpoint.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Pinned release-evidence block; update deliberately after re-running preflight.
ROBINHOOD_FORK_BLOCK=22642189

# Keep the real value only in contracts/.env (ignored by git).
DEPLOYER_PRIVATE_KEY=

# Final two-step owner, ideally a Safe. This address must accept ownership
# after deployment before launch can be enabled.
FINAL_OWNER=

# Receives the 25% treasury PIPEDOG acquisition lane.
TREASURY_WALLET=

# Receives the 50% operations ETH lane.
OPERATIONS_WALLET=

# Optional policy caps and launch fee.
LAYPIPE_LAUNCH_FEE_WEI=500000000000000
MAX_SEQUESTER_PER_CALL_WEI=100000000000000000
MAX_TREASURY_BUY_PER_CALL_WEI=100000000000000000
