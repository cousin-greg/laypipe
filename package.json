{
  "name": "laypipe-fun",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/verify-production-config.ts --deployment",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/indexer/migrate.ts",
    "db:grant-runtime": "tsx scripts/indexer/runtime-grants.ts",
    "db:reconcile": "tsx scripts/indexer/reconcile.ts",
    "test": "npm run build && node --test tests/*.test.mjs && npm run verify:runtime",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:production-config": "tsx scripts/verify-production-config.ts --profile",
    "lint": "eslint . --ignore-pattern outputs --ignore-pattern .next"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@next/env": "16.2.12",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.0.1",
    "multiformats": "^13.4.1",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
